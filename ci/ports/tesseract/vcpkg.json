{
  "name": "tesseract",
  "version": "5.5.4",
  "description": "Tesseract OCR Engine",
  "homepage": "https://github.com/tesseract-ocr/tesseract",
  "license": "Apache-2.0",
  "supports": "!uwp",
  "dependencies": [
    { "name": "cpu-features", "platform": "android" },
    { "name": "curl", "default-features": false },
    "leptonica",
    { "name": "libarchive", "default-features": false },
    { "name": "vcpkg-cmake", "host": true },
    { "name": "vcpkg-cmake-config", "host": true }
  ],
  "features": {
    "training-tools": {
      "description": "Build training tools",
      "dependencies": ["cairo", "fontconfig", "icu", "pango"]
    }
  }
}
